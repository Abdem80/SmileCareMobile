<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_squareround"
            android:backgroundTint="@color/hospitalfashion">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_squareround"
                android:backgroundTint="@color/bluey"
                android:paddingHorizontal="10dp"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/paiement_date"
                    android:layout_width="290dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:fontFamily="@font/leaguespartan_bold"
                    android:text="0000-00-00"
                    android:textSize="20dp"/>
                <TextView
                    android:id="@+id/paiement_montant"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:fontFamily="@font/leaguespartan_bold"
                    android:textAlignment="textEnd"
                    android:text="0$"
                    android:textSize="20dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/paiement_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bluepain"
                    android:fontFamily="@font/leaguespartan_bold"
                    android:text="Méthode de paiement : TEST" />

                <TextView
                    android:id="@+id/paiement_etat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bluepain"
                    android:fontFamily="@font/leaguespartan_bold"
                    android:text="État du paiement : TEST" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>