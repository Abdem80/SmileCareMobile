<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titre_inscription"
            android:textColor="@color/bleu_principal"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Photo + Nom/Prénom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Photo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_photo"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@android:drawable/ic_menu_camera" />

                <Button
                    android:id="@+id/btn_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choisir_photo"
                    android:textSize="10sp"
                    android:background="@null"
                    android:textColor="@color/blanc"/>

            </LinearLayout>

            <!-- Prénom + Nom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_prenom"
                    android:textColor="@color/bleu_texte"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/et_prenom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:inputType="textPersonName"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_nom"
                    android:textColor="@color/bleu_texte"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/et_nom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:inputType="textPersonName"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Courriel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_email"
            android:textColor="@color/bleu_texte"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress"/>

        <!-- Adresse -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_adresse"
            android:textColor="@color/bleu_texte"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPostalAddress"/>

        <!-- Assurance + Téléphone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_num_assurance"
                    android:textColor="@color/bleu_texte"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/et_num_assurance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:inputType="text"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_telephone"
                    android:textColor="@color/bleu_texte"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/et_telephone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:inputType="phone"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Date naissance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_date_naissance"
            android:textColor="@color/bleu_texte"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_date_naissance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:inputType="date"/>

        <!-- Mot de passe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_mdp"
            android:textColor="@color/bleu_texte"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_mdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:padding="10dp"
            android:layout_marginBottom="24dp"
            android:inputType="textPassword"/>

        <!-- Bouton inscrire -->
        <Button
            android:id="@+id/btn_inscrire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:text="@string/btn_inscrire"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:padding="14dp"/>

    </LinearLayout>

</ScrollView>